# INTERVUE — Environment Variables
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets to Git.
#
# Owner: All team members — coordinate before adding new variables.

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------

# API key for the LLM provider (Google Gemini, OpenAI, Anthropic, etc.)
# Required for AI modules to function.
LLM_API_KEY=

# Model identifier to use for interview and evaluation calls.
# Example: gemini-1.5-pro, gpt-4o, claude-3-5-sonnet-20241022
LLM_MODEL=

# Optional: Base URL override for the LLM API endpoint.
# Leave blank to use the provider's default endpoint.
LLM_BASE_URL=

# ---------------------------------------------------------------------------
# Voice (Optional — not yet implemented)
# ---------------------------------------------------------------------------

# API key for voice/STT/TTS provider (if using a paid service).
# Leave blank until voice is implemented.
VOICE_API_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Public application name displayed in the UI.
NEXT_PUBLIC_APP_NAME=INTERVUE
